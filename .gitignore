# Default deny: only reviewed source/tooling/development docs are shared.
# Real data, local configuration, tests and historical evidence stay on this machine.
/*
!/.gitattributes
!/.gitignore
!/.npmrc
!/AGENTS.md
!/CONTEXT.md
!/DEVELOPMENT_PROGRESS.md
!/GPT_CONTEXT.md
!/PRODUCT_REQUIREMENTS.md
!/README.md
!/SYSTEM_ARCHITECTURE.md
!/package-lock.json
!/package.json
!/tsconfig.json
!/workbench.config.example.json
!/启动工作台.cmd
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/pre-push
!/packages/
/packages/*
!/packages/server/
!/packages/web/
/packages/server/*
!/packages/server/package.json
!/packages/server/src/
/packages/web/*
!/packages/web/package.json
!/packages/web/src/
!/packages/web/index.html
!/packages/web/tsconfig.json
!/packages/web/vite.config.ts
!/scripts/
/scripts/*
!/scripts/backup.mjs
!/scripts/check-repository.mjs
!/scripts/dev-monthly.mjs
!/scripts/dev-server.mjs
!/scripts/docs-maintenance.mjs
!/scripts/install-git-hooks.mjs
!/scripts/isolation-env.mjs
!/scripts/pack.mjs
!/scripts/repository-policy.mjs
!/scripts/snapshot.mjs
!/scripts/start.mjs
!/scripts/start-release.mjs
!/scripts/start-source.mjs
!/scripts/source-build.mjs
!/scripts/source-upgrade.mjs
!/scripts/test-isolated.mjs
!/scripts/test-preflight.mjs
!/docs/
/docs/*
!/docs/README.md
!/docs/knowledge-index.json
!/docs/guides/
/docs/guides/*
!/docs/guides/*.md
!/docs/management/
/docs/management/*
!/docs/management/*.md
!/docs/reference/
/docs/reference/*
!/docs/reference/DATA_AND_API.md
!/docs/reference/source-inventory.json

# Local-only content is also blocked by the repository guard.
node_modules/
dist/
web-dist/
test/
tests/
__tests__/
fixtures/
data/
outputs/
work/
.local/
.tmp/
.npm-cache/
.repair-delivery/
*.log
*.db
*.db-*
*.sqlite
*.sqlite3
*.docx
*.xlsx
*.pdf
*.zip
*.tar.gz
*.pem
*.key
*.p12
*.pfx
.env
.env.*
*.local.*
*.test.*
*.spec.*
Thumbs.db
.DS_Store
/workbench.config.json
/packages/server/src/cli/make-samples.ts
/packages/server/src/cli/seed-monthly-review.ts
